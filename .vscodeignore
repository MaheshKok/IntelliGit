# Source files (compiled versions are in dist/)
src/**

# Node modules (dependencies bundled in dist/)
node_modules/**

# TypeScript config
tsconfig*.json

# Test files. The runner configs are matched by pattern rather than by name:
# this line used to read `vitest.config.ts`, and `playwright.e2e.config.ts`
# shipped because nobody remembered to add it when it was created.
tests/**
**/*.test.ts
**/*.spec.ts
**/*.config.ts
coverage/**

# Development configuration
.eslintrc*
eslint.config.*
.prettierrc*
.prettierignore
.editorconfig
.dependency-cruiser.cjs
doctor.config.*
knip.json*
.env*
AGENTS.md

# Planning and build-protocol artifacts (PLAN.md, PLAN-REVIEW-LOG.md, gate manifest)
PLAN*.md
.claudex-gates.json

# Build-provenance manifest: consumed by the test harness's provenance gate
# (scripts/verifyBuildProvenance.js), not by the installed extension at runtime.
dist/.build-manifest.json

# Repository automation that has no meaning inside an installed extension
.githooks/**
.pre-commit-config.yaml
.coderabbit.yaml

# Build tools and caches
.vscode/**
.idea/**
*.log
.cache/**

# Source maps. This was `*.map`, which matches only the package root -- every
# real map lives in dist/, so all eight of them shipped: 32 MB of the 54 MB
# payload, and each one carries `sourcesContent`, i.e. the complete original
# TypeScript of the extension and every webview. Nothing at runtime reads them.
**/*.map

# Marketplace screenshots. The README references these with repo-relative paths,
# and vsce rewrites those to https://github.com/.../raw/HEAD/... at package time,
# so the marketplace fetches them from GitHub and the packaged copies are never
# read by anything. Verified by inspecting README.md inside the built .vsix.
media/screenshots/**

# Developer documentation: plans, specs, runbooks, threat models, and the
# localization review CSV. None of it is reachable from the installed extension.
# DESIGN.md and PRODUCT.md are the same thing at the repository root -- neither
# is referenced by README.md or package.json, so the marketplace never renders
# them. README.md, CHANGELOG.md, and LICENSE.txt are kept: the marketplace
# reads all three.
docs/**
DESIGN.md
PRODUCT.md

# Local tool output. Both are gitignored, which is NOT enough -- vsce packages
# the working directory, not the git index, so an ignored directory still ships
# unless it is named here too.
.codebase-memory/**
test-results/**

# Git files
.git/**
.gitignore
.gitattributes

# CI/CD files
.github/**

# Package manager files
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock

# Misc development files
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Claude, swarm, and local code-intelligence data
.claude/**
.claude-flow/**
.agents/**
.codex/**
.hermes/**
.gitnexus/**
.impeccable/**
.ruff_cache/**
.serena/**
.mcp.json
CLAUDE.md
*.db
*.db-shm
*.db-wal


# Build scripts
scripts/**
